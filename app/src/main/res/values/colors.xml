    <!--
      Tone-based surface roles. Material Components 1.11+ resolve component surfaces
      (cards, menus, sheets, dialogs) from these instead of elevation overlays, so they
      must be declared in light mode too. Without them light mode falls back to the
      baseline neutral palette and cards read purple-grey against our green-tinted
      background.
    -->
    <color name="fanficfare_surface_dim">#DCDCD3</color>
    <color name="fanficfare_surface_bright">#FDFDF5</color>
    <color name="fanficfare_surface_container_lowest_opaque">#FFFFFF</color>
