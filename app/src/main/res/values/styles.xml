<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Aharana" parent="Theme.Material3Expressive.DayNight.NoActionBar">
        <item name="colorPrimary">@color/fanficfare_primary</item>
        <item name="colorOnPrimary">@color/fanficfare_on_primary</item>
        <item name="colorPrimaryContainer">@color/fanficfare_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/fanficfare_on_primary_container</item>

        <item name="colorSecondary">@color/fanficfare_secondary</item>
        <item name="colorSecondaryContainer">@color/fanficfare_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/fanficfare_on_secondary_container</item>

        <item name="colorTertiary">@color/fanficfare_tertiary</item>
        <item name="colorTertiaryContainer">@color/fanficfare_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/fanficfare_on_tertiary_container</item>

        <item name="colorError">@color/fanficfare_error</item>
        <item name="colorErrorContainer">@color/fanficfare_error_container</item>
        <item name="colorOnError">@color/fanficfare_on_error</item>
        <item name="colorOnErrorContainer">@color/fanficfare_on_error_container</item>

        <item name="android:colorBackground">@color/fanficfare_background</item>
        <item name="colorSurface">@color/fanficfare_surface</item>
        <item name="colorOnSurface">@color/fanficfare_on_surface</item>
        <item name="colorSurfaceVariant">@color/fanficfare_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/fanficfare_on_surface_variant</item>
    </style>

    <!--
      Share receiver: a Material-themed translucent activity. It must inherit from an
      AppCompat/Material theme because ShareReceiverActivity extends AppCompatActivity
      (via BaseActivity). The previous @android:style/Theme.Translucent.NoTitleBar is a
      platform theme and would crash AppCompat at launch.
    -->
    <style name="Theme.Aharana.Translucent" parent="Theme.Material3Expressive.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
