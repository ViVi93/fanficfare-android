<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Theme">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textNoSuggestions"
                android:focusable="false"
                android:clickable="true"
                android:cursorVisible="false" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Default Output Directory"
            android:textSize="@dimen/m3_title_medium"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/inputOutputDir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="/storage/emulated/0/FanFicFare"
            android:inputType="textUri" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonPickFolder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Pick Folder"
            style="@style/Widget.Material3.Button.OutlinedButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Save"
            style="@style/Widget.Material3.Button.OutlinedButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonAllFilesAccess"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Grant All Files Access"
            style="@style/Widget.Material3.Button.OutlinedButton" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="?android:attr/listDivider" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FanFicFare Configuration"
            android:textSize="@dimen/m3_title_medium"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textConfigStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="No personal.ini imported"
            android:textSize="@dimen/m3_body_medium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonImportConfig"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Import personal.ini"
            style="@style/Widget.Material3.Button.OutlinedButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonRemoveConfig"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Remove personal.ini"
            android:enabled="false"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:textColor="?attr/colorError" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="?android:attr/listDivider" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Python download debug"
            android:textSize="@dimen/m3_title_medium"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textPythonDebugLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="No log yet"
            android:textSize="@dimen/m3_body_small" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonRefreshPythonDebug"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Refresh debug log"
                style="@style/Widget.Material3.Button.TextButton" />

            <Space
                android:layout_width="16dp"
                android:layout_height="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonClearPythonDebug"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clear debug log"
                style="@style/Widget.Material3.Button.TextButton" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="?android:attr/listDivider" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DNS diagnostics"
            android:textSize="@dimen/m3_title_medium"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textDnsDiagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="No DNS diagnostics run yet"
            android:textSize="@dimen/m3_body_small" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonRunDnsDiagnostics"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Run DNS diagnostics"
            style="@style/Widget.Material3.Button.ElevatedButton" />

    </LinearLayout>
</ScrollView>
